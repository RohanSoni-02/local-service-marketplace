# Database — leave unset in development to use a local SQLite file (./data/thikana.db).
# In production point these at a Turso database (free tier: https://turso.tech).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public origin of the deployment, used for metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# There is no merchant app yet, so shop responses (offers, job progress, chat
# replies) are generated by lib/server/simulator.ts. Set to "false" once real
# shops are responding.
SIMULATE_SHOPS=true
